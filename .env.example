CARGO_BRONZE_ID=
CARGO_PRATA_ID=
CARGO_OURO_ID=
CARGO_PLATINA_ID=
CARGO_DIAMANTE_ID=
CARGO_CHAMPION_ID=
CARGO_GRAND_CHAMPION_ID=
CARGO_OMEGA_CHAMPION_ID=

# Start.gg GraphQL (campeonato, https://api.start.gg/gql/alpha)
